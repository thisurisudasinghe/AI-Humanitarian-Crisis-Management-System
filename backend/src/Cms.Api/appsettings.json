{
  "Jwt": {
    "Issuer": "Cms.Api",
    "Audience": "Cms.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads"
  },
  "Outbox": {
    "ProcessorEnabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxRetries": 3,
    "RetryDelaySeconds": 30,
    "StaleProcessingMinutes": 10
  },
  "AllowedHosts": "*"
}
