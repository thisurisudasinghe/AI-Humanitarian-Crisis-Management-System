<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cms.Application\Cms.Application.csproj" />
    <ProjectReference Include="..\Cms.Domain\Cms.Domain.csproj" />
  </ItemGroup>

  <!-- Safeway verification emails are rendered from the shared design templates. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\docs\email-templates\email-verification-register.html" LogicalName="Cms.Infrastructure.EmailTemplates.Register.Html" />
    <EmbeddedResource Include="..\..\..\docs\email-templates\email-verification-register.txt" LogicalName="Cms.Infrastructure.EmailTemplates.Register.Text" />
    <EmbeddedResource Include="..\..\..\docs\email-templates\email-verification-resend.html" LogicalName="Cms.Infrastructure.EmailTemplates.Resend.Html" />
    <EmbeddedResource Include="..\..\..\docs\email-templates\email-verification-resend.txt" LogicalName="Cms.Infrastructure.EmailTemplates.Resend.Text" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>