{
  "info": {
    "name": "CMS Master - Dev 1",
    "description": "Master collection for identity, administration, audit, KPIs and health. Other members add their module folders. Set baseUrl, adminEmail and password variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5210" },
    { "key": "adminEmail", "value": "admin@example.org" },
    { "key": "password", "value": "Demo1234!" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/Health", "host": ["{{baseUrl}}"], "path": ["api", "Health"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register citizen",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"New Citizen\",\n  \"email\": \"citizen{{$randomInt}}@example.org\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
          }
        },
        {
          "name": "Login admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "refresh"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?page=1&pageSize=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Case Manager\",\n  \"email\": \"manager{{$randomInt}}@example.org\",\n  \"password\": \"{{password}}\",\n  \"roles\": [\"CaseManager\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users"] }
          }
        }
      ]
    },
    {
      "name": "Organisations",
      "item": [
        {
          "name": "List organisations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/organisations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "organisations"] }
          }
        }
      ]
    },
    {
      "name": "Admin config",
      "item": [
        {
          "name": "Get config",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/config", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "config"] }
          }
        },
        {
          "name": "Patch config",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"settings\": [\n    { \"key\": \"SlaHours\", \"value\": \"24\" },\n    { \"key\": \"ReorderThreshold\", \"value\": \"10\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/config", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "config"] }
          }
        }
      ]
    },
    {
      "name": "Audit events",
      "item": [
        {
          "name": "Query audit events",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/audit-events?page=1&pageSize=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "audit-events"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "50" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "KPIs",
      "item": [
        {
          "name": "Get KPI report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/kpis?from=2026-11-01T00:00:00Z&to=2026-11-30T00:00:00Z",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "kpis"],
              "query": [
                { "key": "from", "value": "2026-11-01T00:00:00Z" },
                { "key": "to", "value": "2026-11-30T00:00:00Z" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Placeholder module folders",
      "item": [
        { "name": "Cases (Member 2)", "item": [] },
        { "name": "AI (Member 3)", "item": [] },
        { "name": "Governance (Member 3)", "item": [] },
        { "name": "Resources/Shelter/Volunteers/Mapping (Member 4)", "item": [] },
        { "name": "Donations (Dev 1 P2 - only if retained)", "item": [] }
      ]
    }
  ]
}
