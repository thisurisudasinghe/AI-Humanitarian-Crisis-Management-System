            },
            "url": { "raw": "{{baseUrl}}/api/v1/organisations/{{organisationId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "organisations", "{{organisationId}}"] }
          }
        },
        {
          "name": "Deactivate organisation",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": false\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/organisations/{{organisationId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "organisations", "{{organisationId}}"] }
          }
        }
      ]
    },
    {
      "name": "Admin config",
      "item": [
        {
          "name": "Get config",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/config", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "config"] }
          }
        },
        {
          "name": "Patch config",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
