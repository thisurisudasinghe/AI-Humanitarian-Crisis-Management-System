            "url": { "raw": "{{baseUrl}}/api/v1/organisations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "organisations"] }
          }
        },
        {
          "name": "Get organisation by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/organisations/{{organisationId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "organisations", "{{organisationId}}"] }
          }
        },
        {
          "name": "Create organisation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('organisationId', body.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Partner Org {{$randomInt}}\",\n  \"organisationType\": \"NonGovernmentalOrganisation\",\n  \"contactEmail\": \"partner{{$randomInt}}@example.org\",\n  \"contactPhone\": \"+94770000000\",\n  \"address\": \"Colombo\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/organisations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "organisations"] }
          }
        },
        {
          "name": "Update organisation",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contactEmail\": \"contact@example.org\",\n  \"address\": \"123 Test Street\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/organisations/{{organisationId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "organisations", "{{organisationId}}"] }
          }
        },
        {
          "name": "Deactivate organisation",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"isActive\": false\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/organisations/{{organisationId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "organisations", "{{organisationId}}"] }
          }
        }
      ]
    },
    {
      "name": "Admin config",
      "item": [
        {
          "name": "Get config",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/admin/config", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "config"] }
          }
        },
        {
          "name": "Patch config",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"settings\": [\n    { \"key\": \"SlaHours\", \"value\": \"24\" },\n    { \"key\": \"ReorderThreshold\", \"value\": \"10\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/admin/config", "host": ["{{baseUrl}}"], "path": ["api", "v1", "admin", "config"] }
          }
        }
      ]
    },
    {
      "name": "Audit events",
      "item": [
        {
          "name": "Query audit events",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/audit-events?page=1&pageSize=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "audit-events"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Filter audit by action",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/audit-events?action=Config.Updated&page=1&pageSize=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "audit-events"],
              "query": [
                { "key": "action", "value": "Config.Updated" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Filter audit by actor",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/audit-events?actorUserId={{userId}}&page=1&pageSize=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "audit-events"],
              "query": [
                { "key": "actorUserId", "value": "{{userId}}" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "50" }
              ]
            }
          }
        },
