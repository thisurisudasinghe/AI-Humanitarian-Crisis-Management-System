                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "50" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "KPIs",
      "item": [
        {
          "name": "Get KPI report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/kpis?from=2026-11-01T00:00:00Z&to=2026-11-30T00:00:00Z",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "kpis"],
              "query": [
                { "key": "from", "value": "2026-11-01T00:00:00Z" },
                { "key": "to", "value": "2026-11-30T00:00:00Z" }
              ]
            }
          }
        },
