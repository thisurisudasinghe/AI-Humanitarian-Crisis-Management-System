              "raw": "{{baseUrl}}/api/v1/audit-events?from=2026-11-01T00:00:00Z&to=2026-11-30T23:59:59Z&page=1&pageSize=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "audit-events"],
              "query": [
                { "key": "from", "value": "2026-11-01T00:00:00Z" },
                { "key": "to", "value": "2026-11-30T23:59:59Z" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "50" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "KPIs",
      "item": [
        {
          "name": "Get KPI report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/kpis?from=2026-11-01T00:00:00Z&to=2026-11-30T00:00:00Z",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "kpis"],
              "query": [
                { "key": "from", "value": "2026-11-01T00:00:00Z" },
                { "key": "to", "value": "2026-11-30T00:00:00Z" }
              ]
            }
          }
        },
        {
          "name": "Get KPI report filtered by crisis and area",
          "request": {
            "description": "Set crisisEventId and areaId collection variables to real GUIDs. Blank values are omitted.",
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/kpis?from=2026-11-01T00:00:00Z&to=2026-11-30T00:00:00Z&crisisEventId={{crisisEventId}}&areaId={{areaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "kpis"],
              "query": [
                { "key": "from", "value": "2026-11-01T00:00:00Z" },
                { "key": "to", "value": "2026-11-30T00:00:00Z" },
                { "key": "crisisEventId", "value": "{{crisisEventId}}" },
                { "key": "areaId", "value": "{{areaId}}" }
              ]
            }
          }
        }
      ]
    },
