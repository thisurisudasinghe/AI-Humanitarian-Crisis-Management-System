{
    "info": {
        "name": "Member 4 - Operations APIs",
        "description": "P1 endpoint coverage for the Member 4 operations slice (M5 resources, M6 shelters, M7 volunteers, M10 mapping). Set bearerToken to a JWT with the role named in each request description. decisionId must be an approved decision produced by Member 3; allocationId/dispatchId/taskId/transitionId are captured by tests or pasted after a create call. For POST /allocations keep the same idempotencyKey when retrying and generate a fresh one for a new allocation attempt.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            { "key": "token", "value": "{{bearerToken}}", "type": "string" }
        ]
    },
    "variable": [
        { "key": "baseUrl", "value": "https://localhost:7001" },
        { "key": "bearerToken", "value": "" },
        { "key": "requestId", "value": "1d000000-0000-0000-0000-000000000006" },
        { "key": "decisionId", "value": "" },
        { "key": "allocationId", "value": "" },
        { "key": "dispatchId", "value": "" },
        { "key": "shelterId", "value": "44000000-0000-0000-0000-000000000001" },
        { "key": "volunteerId", "value": "45000000-0000-0000-0000-000000000001" },
        { "key": "resourceTypeId", "value": "41000000-0000-0000-0000-000000000001" },
        { "key": "orgId", "value": "0f000000-0000-0000-0000-000000000001" },
        { "key": "idempotencyKey", "value": "" },
        { "key": "inventoryId", "value": "" },
        { "key": "taskId", "value": "" },
        { "key": "assistanceRequestId", "value": "" },
        { "key": "transitionId", "value": "" },
        { "key": "availabilityStart", "value": "2026-11-23T08:00:00Z" },
        { "key": "availabilityEnd", "value": "2026-11-23T17:00:00Z" }
    ],
    "item": [{
            "name": "Resources and inventory",
            "item": [{
                    "name": "GET /resources",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/api/v1/resources", "host": ["{{baseUrl}}"], "path": ["api", "v1", "resources"] },
                        "description": "Resource types (staff: LogisticsManager, EmergencyCoordinator or SystemAdmin). Alias of /resources/types."
                    }
                },
                {
                    "name": "GET /resources/types",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/api/v1/resources/types", "host": ["{{baseUrl}}"], "path": ["api", "v1", "resources", "types"] },
                        "description": "Resource types; use resourceTypeId in other requests."
                    }
                },
                {
                    "name": "POST /resources/types",
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('created or duplicate conflict', () => pm.expect([201, 409]).to.include(pm.response.code));",
                                "if (pm.response.code === 201) pm.collectionVariables.set('resourceTypeId', pm.response.json().id);",
                                "pm.test('errors are ProblemDetails with code', () => { if (pm.response.code >= 400) pm.expect(pm.response.json()).to.have.property('code'); });"
                            ]
                        }
                    }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\"name\":\"Emergency food pack\",\"unit\":\"packs\",\"description\":\"Demo resource type\"}", "options": { "raw": { "language": "json" } } },
                        "url": { "raw": "{{baseUrl}}/api/v1/resources/types", "host": ["{{baseUrl}}"], "path": ["api", "v1", "resources", "types"] },
                        "description": "Create a resource type (LogisticsManager or SystemAdmin). Names are unique; a duplicate returns 409."
                    }
                },
                {
                    "name": "GET /inventories",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/inventories?orgId={{orgId}}&resourceTypeId={{resourceTypeId}}&lowStock=false&page=1&pageSize=50",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "inventories"],
                            "query": [
                                { "key": "orgId", "value": "{{orgId}}" },
                                { "key": "resourceTypeId", "value": "{{resourceTypeId}}" },
                                { "key": "areaId", "value": "", "disabled": true },
                                { "key": "lowStock", "value": "false" },
                                { "key": "page", "value": "1" },
                                { "key": "pageSize", "value": "50" }
                            ]
                        },
                        "description": "Stock buckets and lowStock flag (Available <= ReorderThreshold). Staff roles; non-privileged users are org-scoped."
                    }
                },
                {
                    "name": "POST /inventories",
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('inventory created', () => pm.expect(pm.response.code).to.eql(201));"
                            ]
                        }
                    }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\"resourceTypeId\":\"{{resourceTypeId}}\",\"orgId\":\"{{orgId}}\",\"quantity\":20,\"reorderThreshold\":3,\"expiryDate\":null,\"lat\":7.2088,\"lng\":79.8358,\"accessibilityCapable\":true}", "options": { "raw": { "language": "json" } } },
                        "url": { "raw": "{{baseUrl}}/api/v1/inventories", "host": ["{{baseUrl}}"], "path": ["api", "v1", "inventories"] },
                        "description": "Create stock (LogisticsManager or SystemAdmin). Available is initialised to Quantity; other buckets start at zero."
                    }
                },
                {
                    "name": "PATCH /inventories/{id}",
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('updated or guarded conflict', () => pm.expect([200, 409]).to.include(pm.response.code));",
                                "pm.test('guard uses INVENTORY_BELOW_COMMITTED when applicable', () => { if (pm.response.code === 409) pm.expect(pm.response.json().code).to.eql('INVENTORY_BELOW_COMMITTED'); });"
                            ]
                        }
                    }],
                    "request": {
                        "method": "PATCH",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\"quantity\":20,\"reorderThreshold\":3,\"expiryDate\":null,\"lat\":7.2088,\"lng\":79.8358,\"accessibilityCapable\":true}", "options": { "raw": { "language": "json" } } },
                        "url": { "raw": "{{baseUrl}}/api/v1/inventories/{{inventoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "inventories", "{{inventoryId}}"] },
                        "description": "Correct stock (LogisticsManager or SystemAdmin). Quantity cannot drop below Reserved + Allocated + Dispatched + Utilised. Set inventoryId in variables from a create/list response."
                    }
                }
            ]
        },
        {
            "name": "Allocation and dispatch (decision gate + stock guard)",
            "item": [{
                    "name": "GET /allocations",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/allocations?requestId={{requestId}}&status=Allocated&page=1&pageSize=50",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "allocations"],
                            "query": [
                                { "key": "requestId", "value": "{{requestId}}" },
                                { "key": "status", "value": "Allocated" },
                                { "key": "page", "value": "1" },
                                { "key": "pageSize", "value": "50" }
                            ]
                        },
                        "description": "List allocations; staff roles, org-scoped for non-privileged callers."
                    }
                },
                {
                    "name": "POST /allocations (Idempotency-Key required)",
                    "event": [{
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (!pm.collectionVariables.get('idempotencyKey')) pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('created (201) or replayed (200)', () => pm.expect([200, 201]).to.include(pm.response.code));",
                                    "if (pm.response.code === 201) { pm.collectionVariables.set('allocationId', pm.response.json().id); pm.collectionVariables.set('decisionId', pm.response.json().decisionId); }",
                                    "pm.test('409 is INSUFFICIENT_STOCK', () => { if (pm.response.code === 409) pm.expect(pm.response.json().code).to.eql('INSUFFICIENT_STOCK'); });",
                                    "pm.test('403 is a decision gate failure with ProblemDetails code', () => { if (pm.response.code === 403) pm.expect(pm.response.json()).to.have.property('code'); });"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
                        ],
                        "body": { "mode": "raw", "raw": "{\"decisionId\":\"{{decisionId}}\"}", "options": { "raw": { "language": "json" } } },
                        "url": { "raw": "{{baseUrl}}/api/v1/allocations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "allocations"] },
                        "description": "LogisticsManager or EmergencyCoordinator. Body contains decisionId ONLY. The service re-reads inventoryId and quantity from the approved decision's FinalPayloadJson. Header Idempotency-Key is mandatory (<=256 chars). Missing header -> 400 IDEMPOTENCY_KEY_REQUIRED; rejected/mismatched decision -> 403; zero guarded rows -> 409 INSUFFICIENT_STOCK. Retry with the SAME key and a new key for a new attempt."
                    }
                },
                {
                    "name": "POST /allocations (negative: missing Idempotency-Key)",
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('missing key is 400 IDEMPOTENCY_KEY_REQUIRED', () => { pm.expect(pm.response.code).to.eql(400); pm.expect(pm.response.json().code).to.eql('IDEMPOTENCY_KEY_REQUIRED'); });"
                            ]
                        }
                    }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\"decisionId\":\"{{decisionId}}\"}", "options": { "raw": { "language": "json" } } },
                        "url": { "raw": "{{baseUrl}}/api/v1/allocations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "allocations"] },
                        "description": "Negative check: deliberately omit the Idempotency-Key header. Expect 400 with ProblemDetails code IDEMPOTENCY_KEY_REQUIRED."
                    }
                },
                {
                    "name": "GET /dispatches",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/dispatches?allocationId={{allocationId}}&page=1&pageSize=50",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "dispatches"],
                            "query": [
                                { "key": "allocationId", "value": "{{allocationId}}" },
                                { "key": "page", "value": "1" },
                                { "key": "pageSize", "value": "50" }
                            ]
                        },
                        "description": "List dispatches staff, org-scoped. ConfirmedAt and ConfirmedBy are populated after delivery confirmation."
                    }
                },
                {
                    "name": "POST /dispatches",
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('dispatch accepted/replayed', () => pm.expect([200, 409]).to.include(pm.response.code));",
                                "if (pm.response.code === 200) pm.collectionVariables.set('dispatchId', pm.response.json().id);",
                                "pm.test('409 is INVALID_TRANSITION or bucket mismatch', () => { if (pm.response.code === 409) pm.expect(['INVALID_TRANSITION','INVENTORY_BUCKET_MISMATCH']).to.include(pm.response.json().code); });"
                            ]
                        }
                    }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\"decisionId\":\"{{decisionId}}\",\"allocationId\":\"{{allocationId}}\"}", "options": { "raw": { "language": "json" } } },
                        "url": { "raw": "{{baseUrl}}/api/v1/dispatches", "host": ["{{baseUrl}}"], "path": ["api", "v1", "dispatches"] },
                        "description": "LogisticsManager. Decision is re-verified; stock moves Allocated -> Dispatched only. Repeat with the same decision returns the existing dispatch (200)."
                    }
                },
                {
                    "name": "POST /dispatches/{allocationId}",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\"decisionId\":\"{{decisionId}}\"}", "options": { "raw": { "language": "json" } } },
                        "url": { "raw": "{{baseUrl}}/api/v1/dispatches/{{allocationId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "dispatches", "{{allocationId}}"] },
                        "description": "LogisticsManager. Path variant; body contains decisionId only."
                    }
                },
                {
                    "name": "POST /dispatches/confirm",
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('confirmation accepted or replayed', () => pm.expect([200, 409]).to.include(pm.response.code));",
                                "if (pm.response.code === 409) pm.test('guard code is exposed', () => pm.expect(pm.response.json()).to.have.property('code'));"
                            ]
                        }
                    }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\"decisionId\":\"{{decisionId}}\",\"dispatchId\":\"{{dispatchId}}\"}", "options": { "raw": { "language": "json" } } },
                        "url": { "raw": "{{baseUrl}}/api/v1/dispatches/confirm", "host": ["{{baseUrl}}"], "path": ["api", "v1", "dispatches", "confirm"] },
                        "description": "LogisticsManager. Records ConfirmedAt/ConfirmedBy, moves Dispatched -> Utilised and transitions the request to Fulfilled. Repeat returns unchanged state."
                    }
                },
                {
                    "name": "POST /dispatches/{dispatchId}/confirm",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\"decisionId\":\"{{decisionId}}\"}", "options": { "raw": { "language": "json" } } },
                        "url": { "raw": "{{baseUrl}}/api/v1/dispatches/{{dispatchId}}/confirm", "host": ["{{baseUrl}}"], "path": ["api", "v1", "dispatches", "{{dispatchId}}", "confirm"] },
                        "description": "LogisticsManager. Path variant of delivery confirmation; body contains decisionId only."
                    }
                }
            ]
        },
        {
            "name": "Shelters",
            "item": [{
                    "name": "GET /shelters",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/shelters?approved=true&orgId={{orgId}}&page=1&pageSize=50",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "shelters"],
                            "query": [
                                { "key": "approved", "value": "true" },
                                { "key": "orgId", "value": "{{orgId}}" },
                                { "key": "page", "value": "1" },
                                { "key": "pageSize", "value": "50" }
                            ]
                        },
                        "description": "ShelterAdmin, EmergencyCoordinator or SystemAdmin. Includes Capacity, Occupancy, FreePlaces, facilities/accessibility/services and coordinates."
                    }
                },
                {
                    "name": "GET /shelters/public",
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('anonymous public list succeeds', () => pm.expect(pm.response.code).to.eql(200));",
                                "pm.test('only approved shelters, no org PII', () => { const rows = pm.response.json(); rows.forEach(r => { pm.expect(r.approved).to.eql(true); pm.expect(r.orgId).to.eql('00000000-0000-0000-0000-000000000000'); }); });"
                            ]
                        }
                    }],
                    "request": {
                        "auth": { "type": "noauth" },
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/api/v1/shelters/public", "host": ["{{baseUrl}}"], "path": ["api", "v1", "shelters", "public"] },
                        "description": "Anonymous, rate-limited public list of approved shelters. OrgId is deliberately projected as Guid.Empty; no contact details."
                    }
                },
                {
                    "name": "POST /shelters",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\"name\":\"Demo Shelter\",\"capacity\":50,\"occupancy\":0,\"facilities\":\"[\\\"Water\\\"]\",\"accessibilityFeatures\":\"[\\\"Wheelchair access\\\"]\",\"services\":\"[\\\"Food\\\"]\",\"lat\":7.2088,\"lng\":79.8358,\"orgId\":\"{{orgId}}\"}", "options": { "raw": { "language": "json" } } },
                        "url": { "raw": "{{baseUrl}}/api/v1/shelters", "host": ["{{baseUrl}}"], "path": ["api", "v1", "shelters"] },
                        "description": "ShelterAdmin or SystemAdmin. Occupancy is always stored as 0; approval is a separate action. Facility/service strings are JSON arrays encoded as strings."
                    }
                },
                {
                    "name": "PATCH /shelters/{id}",
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('updated or capacity guard conflict', () => pm.expect([200, 409]).to.include(pm.response.code));",
                                "pm.test('guard code SHELTER_CAPACITY_BELOW_OCCUPANCY', () => { if (pm.response.code === 409) pm.expect(pm.response.json().code).to.eql('SHELTER_CAPACITY_BELOW_OCCUPANCY'); });"
                            ]
                        }
                    }],
                    "request": {
                        "method": "PATCH",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\"name\":\"Demo Shelter\",\"capacity\":120,\"facilities\":\"[\\\"Water\\\"]\",\"accessibilityFeatures\":\"[\\\"Wheelchair access\\\"]\",\"services\":\"[\\\"Food\\\"]\",\"lat\":7.2088,\"lng\":79.8358}", "options": { "raw": { "language": "json" } } },
                        "url": { "raw": "{{baseUrl}}/api/v1/shelters/{{shelterId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "shelters", "{{shelterId}}"] },
                        "description": "ShelterAdmin or SystemAdmin. Capacity below current Occupancy returns 409 SHELTER_CAPACITY_BELOW_OCCUPANCY."
                    }
                },
                {
                    "name": "POST /shelters/{id}/approve",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/api/v1/shelters/{{shelterId}}/approve", "host": ["{{baseUrl}}"], "path": ["api", "v1", "shelters", "{{shelterId}}", "approve"] },
                        "description": "EmergencyCoordinator or SystemAdmin. Only approved shelters appear in /shelters/public and in shelter matching."
                    }
                },
                {
                    "name": "POST /shelters/allocations",
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('shelter allocation created or full', () => pm.expect([201, 409]).to.include(pm.response.code));",
                                "pm.test('409 is SHELTER_FULL', () => { if (pm.response.code === 409) pm.expect(pm.response.json().code).to.eql('SHELTER_FULL'); });",
                                "pm.test('403 is a decision gate failure', () => { if (pm.response.code === 403) pm.expect(pm.response.json()).to.have.property('code'); });"
                            ]
                        }
                    }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\"decisionId\":\"{{decisionId}}\"}", "options": { "raw": { "language": "json" } } },
                        "url": { "raw": "{{baseUrl}}/api/v1/shelters/allocations", "host": ["{{baseUrl}}"], "path": ["api", "v1", "shelters", "allocations"] },
                        "description": "ShelterAdmin or EmergencyCoordinator. The approved ShelterMatch decision's FinalPayloadJson is the authority for shelterId/requestId/householdSize; client values are ignored. Conditional occupancy UPDATE + insert run in one transaction; a full shelter returns 409 SHELTER_FULL."
                    }
                }
            ]
        },
        {
            "name": "Volunteers and tasks",
            "item": [{
                    "name": "GET /volunteers",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/api/v1/volunteers", "host": ["{{baseUrl}}"], "path": ["api", "v1", "volunteers"] },
                        "description": "VolunteerCoordinator, EmergencyCoordinator or SystemAdmin. Shows verification status and active flag."
                    }
                },
                {
                    "name": "POST /volunteers/profile",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\"skillsJson\":\"[\\\"First aid\\\",\\\"Driving\\\"]\",\"languagesJson\":\"[\\\"English\\\"]\",\"lat\":7.2088,\"lng\":79.8358,\"active\":true}", "options": { "raw": { "language": "json" } } },
                        "url": { "raw": "{{baseUrl}}/api/v1/volunteers/profile", "host": ["{{baseUrl}}"], "path": ["api", "v1", "volunteers", "profile"] },
                        "description": "Volunteer role, self-service. One profile per current user (unique user_id); first save creates a Pending profile. Skills/languages are JSON arrays encoded as strings."
                    }
                },
                {
                    "name": "POST /volunteers/{id}/verify",
                    "event": [{
                        "listen": "test",
                        "script": {
                            "type": "text/javascript",
                            "exec": [
                                "pm.test('verified, rejected or guarded conflict', () => pm.expect([200, 409]).to.include(pm.response.code));",
                                "if (pm.response.code === 409) pm.test('rejected profile guard', () => pm.expect(pm.response.json().code).to.eql('VOLUNTEER_REJECTED'));"
                            ]
                        }
                    }],
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\"approved\":true,\"reason\":\"Documents checked\"}", "options": { "raw": { "language": "json" } } },
                        "url": { "raw": "{{baseUrl}}/api/v1/volunteers/{{volunteerId}}/verify", "host": ["{{baseUrl}}"], "path": ["api", "v1", "volunteers", "{{volunteerId}}", "verify"] },
                        "description": "VolunteerCoordinator or SystemAdmin. Reason is required; only Verified + active volunteers can be assigned or matched."
                    }
                },
                {
                    "name": "POST /volunteers/availability",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": { "mode": "raw", "raw": "{\"startsAt\":\"{{availabilityStart}}\",\"endsAt\":\"{{availabilityEnd}}\"}", "options": { "raw": { "language": "json" } } },
                        "url": { "raw": "{{baseUrl}}/api/v1/volunteers/availability", "host": ["{{baseUrl}}"], "path": ["api", "v1", "volunteers", "availability"] },
                        "description": "Volunteer role, self-service. End must be after start and start cannot be in the past. Update availabilityStart/availabilityEnd variables for the demo date."
                    }
                },
                {
                    "name": "GET /volunteer-tasks/mine",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/volunteer-tasks/mine?page=1&pageSize=50",
                            "host": ["{{baseUrl}}"],
                            "path": ["api", "v1", "volunteer-tasks", "mine"],
                            "query": [{ "key": "page", "value": "1" }, { "key": "pageSize", "value": "50" }]
                        },
                        "description": "Volunteer role. Tasks assigned to the current user's volunteer profile."
                    }
                },
